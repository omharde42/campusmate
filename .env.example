# CampusMate environment configuration.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Public path prefix the API is served under when a gateway forwards it.
# Defaults to /api automatically on Vercel (the services rewrite "/api/(.*)" ->
# backend keeps the prefix). Leave empty for docker-compose, where nginx strips
# /api itself.
ROOT_PATH=

# --- Database --------------------------------------------------------------
# Zero-setup local default (SQLite). docker-compose overrides this with the
# PostgreSQL + pgvector service below.
#
# On Vercel the default is an ephemeral SQLite file in /tmp: the app boots and
# the demo works, but data (and admin edits/tickets) does not persist across
# invocations. For persistent storage set DATABASE_URL to a hosted PostgreSQL
# (e.g. Neon) — the pgvector extension is created automatically on first start.
DATABASE_URL=sqlite:///./campusmate.db
# With docker-compose:
# DATABASE_URL=postgresql+psycopg2://campusmate:campusmate@db:5432/campusmate
# With a hosted PostgreSQL (Vercel):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Model adapters --------------------------------------------------------
# Leave the providers as "stub"/"hashing" for a fully offline demo.
# Set them to "openai" and provide a key to use hosted models.
LLM_PROVIDER=stub
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIM=384

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.08
RETRIEVAL_MIN_COVERAGE=0.5

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=./storage/documents
MAX_UPLOAD_MB=20

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seeding (demo only) ---------------------------------------------------
# Set to 0 to start with an empty database.
CAMPUSMATE_SEED=1

# --- Private administrator -------------------------------------------------
# The admin account is created from these values on first start. The password
# defaults to empty, so NO admin is created until you set it here (or in your
# hosting provider). Keep it out of version control; never shown in the UI.
SEED_ADMIN_EMAIL=admin@your-college.example
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=CampusMate Administrator
