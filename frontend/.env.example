# CampusMate frontend configuration.
# Copy to `.env` if you need to override defaults.

# Base path for API calls. In development the Vite dev server proxies /api to
# the backend (see vite.config.js). In the Docker build nginx proxies /api.
VITE_API_BASE=/api

# Where the dev server proxies API requests (backend origin).
VITE_API_TARGET=http://localhost:8000

# Optional: URL of the CampusMate assistant illustration. Leave empty to use the
# built-in clearly-labelled placeholder mascot.
VITE_MASCOT_URL=
